# Django settings
DEBUG=True
SECRET_KEY=change-me-in-production
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=sqlite:///db.sqlite3

# ---------------------------------------------------------------------------
# Cloudflare R2 (S3-compatible) storage — ON by default (S3 is the default
# storage). Fill in the values below and everything (uploads, static, URLs)
# goes to R2 with no other change. With all of them empty the app runs on
# local disk; a partial set is a startup error.
#
# Once configured, migrate existing files:
#   python manage.py sync_r2        (media)
#   python manage.py collectstatic  (static)
# ---------------------------------------------------------------------------
USE_R2=True
USE_R2_STATIC=True
R2_ACCOUNT_ID=
# R2_ENDPOINT_URL defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
# Custom domain (https://media.example.com) or https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
